# frontend/.env — kopyalayıp değerleri doldurun: cp .env.example .env

# Backend'in kök URL'si (örn. http://127.0.0.1:8000). /api prefix'i kod
# tarafında otomatik eklenir.
REACT_APP_BACKEND_URL=

# Backend'deki backend/.env API_KEY değeriyle AYNI olmalı — POST
# /api/transcribe isteklerinde X-API-Key header'ı olarak gönderilir.
# ÖNEMLİ: Bu değer tarayıcı bundle'ında (derlenmiş JS içinde) görünür olur,
# gizli bir sır DEĞİLDİR — sadece kaba kullanım/bot engeli sağlar. Gerçek
# erişim kontrolü network seviyesinde yapılmalıdır (bkz. README.md).
REACT_APP_API_KEY=

# Opsiyonel, craco.config.js tarafından okunur. "true" ise dev server'a
# Emergent platformuna özgü bir webpack health-check plugin'i eklenir
# (plugins/health-check/). Normal lokal geliştirmede gerekmez, boş bırakın.
ENABLE_HEALTH_CHECK=
