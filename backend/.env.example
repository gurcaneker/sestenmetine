# backend/.env — kopyalayıp değerleri doldurun: cp .env.example .env

# OpenAI Whisper + Anthropic Claude için Emergent evrensel anahtarı.
# Yoksa POST /api/transcribe 500 döner (LLM anahtarı yok hatası).
EMERGENT_LLM_KEY=

# POST /api/transcribe için zorunlu. İstemci bu değeri X-API-Key header'ında
# göndermeli; eşleşmezse 401 döner. Rastgele, uzun bir değer üretin, örn:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Virgülle ayrılmış izinli origin listesi (CORS). Boş bırakılırsa
# localhost:3000/127.0.0.1:3000 kullanılır — production'da gerçek frontend
# domain'i(ler)i buraya yazın, wildcard (*) KULLANMAYIN.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Local mode (opsiyonel, dış API bağımlılığı yok) ----------------------
# "api" (varsayılan): yukarıdaki EMERGENT_LLM_KEY ile OpenAI Whisper API +
#   Claude diarization (mevcut davranış, değişmedi).
# "local": faster-whisper + pyannote.audio ile tamamen yerel/offline çalışır
#   (EMERGENT_LLM_KEY gerekmez) — kurulum ve HF token adımları için
#   README.md "Local mode ile çalıştırma" bölümüne bakın.
TRANSCRIPTION_BACKEND=api

# Sadece TRANSCRIPTION_BACKEND=local iken kullanılır. faster-whisper model
# boyutu: tiny/base/small/medium/large-v3 (büyüdükçe daha doğru ama daha
# yavaş/ağır — CPU'da int8 quantization ile çalışır). İlk kullanımda
# ~/.cache/huggingface'e indirilip cache'lenir, sonraki çalıştırmalar
# offline'dır.
WHISPER_MODEL_SIZE=small

# Sadece TRANSCRIPTION_BACKEND=local iken kullanılır. faster-whisper'ın
# BatchedInferencePipeline'ı için batch boyutu — VAD ile bulunan konuşma
# segmentlerini tek tek değil toplu işler (4 çekirdekli bir VPS'te ~7-8x hız
# kazancı ölçüldü, bkz. BENCHMARK.md). 4/8/16 denendi, aralarında anlamlı
# fark yoktu (test dosyasında ~9 segment vardı) — 8 daha uzun/çok segmentli
# gerçek kayıtlar için de güvenli bir varsayılan.
WHISPER_BATCH_SIZE=8

# Sadece TRANSCRIPTION_BACKEND=local iken ZORUNLU (yoksa sunucu başlangıçta
# net bir hatayla çöker). pyannote/speaker-diarization-3.1 pipeline'ı için
# Hugging Face access token — https://hf.co/settings/tokens üzerinden
# "Read" yetkili bir token oluşturun. Ayrıca modelin (ve altında kullandığı
# pyannote/speaker-diarization-community-1'in) kullanım şartlarını kabul
# etmeniz gerekir — detay için README.md'ye bakın.
HF_TOKEN=
