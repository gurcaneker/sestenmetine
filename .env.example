# Root .env — SADECE docker-compose tarafından okunur (`docker compose up`
# öncesi `cp .env.example .env` yapıp doldurun). Docker DIŞI (lokal, venv/
# yarn ile) geliştirme için bunu değil `backend/.env.example` ve
# `frontend/.env.example`'ı kullanın — onlar ayrı, birbirinden bağımsızdır.
#
# Bu dosyanın iki farklı kullanım şekli var (docker-compose.yml'e bakın):
#   - backend değişkenleri `env_file` ile container runtime'ına enjekte edilir.
#   - REACT_APP_* değişkenleri frontend build ARG'ları için ${VAR} olarak
#     docker-compose.yml içinde kullanılır (BUILD-TIME, container runtime'ı
#     DEĞİL — bkz. frontend/Dockerfile yorumu).

# --- backend (runtime, env_file) ------------------------------------------
# POST /api/transcribe için zorunlu (X-API-Key header eşleşmeli, yoksa 401).
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# OpenAI Whisper + Anthropic Claude için Emergent evrensel anahtarı.
EMERGENT_LLM_KEY=
# frontend nginx.conf /api'yi reverse-proxy ettiği için tarayıcı istekleri
# aynı origin'den gelir — CORS genelde devreye girmez, ama backend'e
# doğrudan (nginx'i atlayarak) erişim varsa gerçek origin'i buraya yazın.
CORS_ORIGINS=http://localhost:3000

# --- frontend (BUILD-TIME, docker-compose.yml build.args) -----------------
# Boş bırakın (varsayılan/önerilen): frontend, backend'e nginx.conf'un
# /api reverse proxy'si üzerinden relatif path ile konuşur. Sadece backend'i
# nginx'i atlayıp DOĞRUDAN farklı bir origin'den çağıracaksanız (örn. ayrı
# domain'lerde deploy) mutlak bir URL girin (örn. https://api.example.com).
REACT_APP_BACKEND_URL=
# backend'deki API_KEY ile AYNI değer olmalı. ÖNEMLİ: bu değer tarayıcı JS
# bundle'ına gömülür, gizli bir sır DEĞİLDİR (bkz. README.md, SECURITY_NOTES.md).
REACT_APP_API_KEY=
